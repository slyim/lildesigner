---
// About Me tab — one big statement on a wide glass panel, per the reference.
import { about } from "../data/about";
---

<div class="scene view-hidden" id="view-about">
  <article class="glass-card about-card" data-tilt>
    <div class="card-glare" data-glare></div>
    <span class="beam-border" aria-hidden="true"></span>

    <p class="about-statement layer">{about.text}</p>
  </article>
</div>

<style>
  .about-card {
    width: min(560px, calc(100vw - 2.5rem));
    padding: 2.6rem 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .about-statement {
    --z: 20px;
    position: relative;
    z-index: 2;
    margin: 0;
    text-align: center;
    font-size: clamp(1.7rem, 5.5vw, 2.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .about-statement strong { font-weight: 800; }
  .about-statement em { font-weight: 600; color: var(--accent-soft); }
</style>

---
// Comment popups: the "all comments" browser and the post composer.
// Rendered at body level (see index.astro) — never inside .cards, whose
// perspective would trap position:fixed and confine these to the card box.
// Driven by src/scripts/comments.ts alongside CommentsCard.
---

<!-- all-comments browser modal -->
<div class="modal" id="commentsModal" hidden>
  <div class="modal-backdrop" data-close-modal></div>
  <div class="glass-card modal-card" role="dialog" aria-modal="true" aria-labelledby="commentsModalTitle">
    <div class="card-glare" data-glare></div>
    <span class="beam-border" aria-hidden="true"></span>
    <header class="modal-head">
      <h2 id="commentsModalTitle">All Comments <span id="commentsModalCount"></span></h2>
      <button class="modal-x" id="commentsModalX" type="button" aria-label="Close all comments">
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </header>
    <div class="modal-sort">
      <span class="sort-wrap">
        <select id="commentsSort" aria-label="Sort comments">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="liked">Most liked</option>
        </select>
        <i class="ph-fill ph-caret-up-down" aria-hidden="true"></i>
      </span>
    </div>
    <div class="modal-list" id="commentsModalList" role="log" aria-live="polite" aria-label="All comments"></div>
  </div>
</div>

<!-- post-comment composer modal (stacks above the browser) -->
<div class="modal modal--above" id="commentsPostModal" hidden>
  <div class="modal-backdrop" data-close-modal></div>
  <div class="glass-card modal-card modal-card--post" role="dialog" aria-modal="true" aria-labelledby="commentsPostTitle">
    <div class="card-glare" data-glare></div>
    <span class="beam-border" aria-hidden="true"></span>
    <header class="modal-head">
      <h2 id="commentsPostTitle">Post Comment</h2>
      <button class="modal-x" id="commentsPostX" type="button" aria-label="Close composer">
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </header>
    <form class="comments-form" id="commentsForm" autocomplete="off">
      <p class="comments-replying" id="commentsReplying" hidden>
        replying to <strong id="commentsReplyingTo"></strong>
        <button type="button" id="commentsCancelReply">cancel</button>
      </p>
      <input
        class="comments-name"
        id="commentsName"
        name="name"
        type="text"
        maxlength="40"
        placeholder="your name"
        aria-label="Your name"
        required
      />
      <textarea
        class="comments-body"
        id="commentsBody"
        name="body"
        rows="6"
        maxlength="500"
        placeholder="Share something nice…"
        aria-label="Your comment"
        required
      ></textarea>
      <button class="comments-post" id="commentsPost" type="submit" disabled>Post Comment</button>
    </form>
  </div>
</div>

<style>
  /* below the cursor blob at z-100, above pills/tabbar/gate */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .modal[hidden] { display: none; }
  .modal--above { z-index: 95; }
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 1, 10, 0.62);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  body.light .modal-backdrop { background: rgba(51, 18, 63, 0.35); }
  .modal-card {
    position: relative;
    width: min(720px, calc(100vw - 2rem));
    max-height: min(84vh, 780px);
    padding: 1.4rem 1.4rem 1.3rem;
    display: flex;
    flex-direction: column;
  }
  .modal-card--post { width: min(520px, calc(100vw - 2rem)); }
  .modal:not([hidden]) .modal-card { animation: modal-in 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .modal:not([hidden]) .modal-backdrop { animation: modal-fade 0.25s ease; }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
  }
  @keyframes modal-fade {
    from { opacity: 0; }
  }
  .modal-head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.2rem;
  }
  .modal-head h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .modal-head h2 span { color: var(--text); }
  .modal-x {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: none;
    border: none;
    border-radius: 10px;
    color: var(--text-body);
    font-size: 1.15rem;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .modal-x:hover { color: var(--text); background: rgba(255, 255, 255, 0.08); }
  body.light .modal-x:hover { background: rgba(51, 18, 63, 0.08); }

  /* sort pill */
  .modal-sort { position: relative; z-index: 2; margin-top: 0.9rem; padding: 0 0.1rem; }
  .sort-wrap { position: relative; display: inline-flex; align-items: center; }
  .sort-wrap select {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 0.65rem 2.4rem 0.65rem 1rem;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  body.light .sort-wrap select { background: rgba(255, 255, 255, 0.55); color: var(--text); border-color: var(--glass-border); }
  .sort-wrap select:hover { border-color: rgba(255, 255, 255, 0.35); }
  .sort-wrap select:focus-visible { border-color: var(--accent); }
  .sort-wrap > i {
    position: absolute;
    right: 0.8rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  .sort-wrap option { background: #1a0827; color: #fff; }

  /* full-width browser list */
  .modal-list {
    position: relative;
    z-index: 2;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: 120px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 122, 217, 0.5) transparent;
    padding: 0.1rem;
  }
  .modal-list::-webkit-scrollbar { width: 5px; }
  .modal-list::-webkit-scrollbar-thumb { background: rgba(255, 122, 217, 0.5); border-radius: 3px; }

  /* composer form */
  .comments-form {
    position: relative;
    z-index: 2;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .comments-replying {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .comments-replying strong { color: var(--accent-soft); }
  .comments-replying button {
    background: none;
    border: none;
    padding: 0 0 0 0.4rem;
    font: inherit;
    font-size: 0.74rem;
    color: var(--text-faint);
    cursor: pointer;
    text-decoration: underline;
  }
  .comments-name, .comments-body {
    width: 100%;
    font: inherit;
    color: var(--text);
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    padding: 0.7rem 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  body.light .comments-name, body.light .comments-body { background: rgba(255, 255, 255, 0.55); }
  .comments-name { font-size: 0.85rem; font-weight: 500; }
  .comments-name::placeholder, .comments-body::placeholder { color: var(--text-faint); }
  .comments-name:focus, .comments-body:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 90, 200, 0.18);
  }
  .comments-body {
    min-width: 0;
    min-height: 150px;
    font-size: 0.92rem;
    font-weight: 300;
    resize: vertical;
    line-height: 1.55;
  }
  .comments-post {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 90, 200, 0.22);
    border: 1px solid rgba(255, 122, 217, 0.45);
    border-radius: 14px;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
  }
  .comments-post:hover { background: rgba(255, 90, 200, 0.35); }
  .comments-post:active { transform: scale(0.98); }
  .comments-post:disabled {
    background: rgba(128, 128, 128, 0.15);
    border-color: var(--glass-border);
    color: var(--text-muted);
    cursor: not-allowed;
    opacity: 0.7;
  }
  .comments-post:disabled:active { transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .modal:not([hidden]) .modal-card, .modal:not([hidden]) .modal-backdrop { animation: none; }
    .comments-name, .comments-body, .comments-post, .modal-x, .sort-wrap select { transition: none; }
  }
</style>

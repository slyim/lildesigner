---
import { profile } from "../data/profile";
---

<div class="scene" id="view-profile">
  <div class="glass-card profile-card" data-tilt>
    <div class="card-glare" data-glare></div>
    <span class="beam-border" aria-hidden="true"></span>

    <!-- Banner -->
    <div class="banner layer" data-depth="12">
      <img src={profile.banner} alt="" aria-hidden="true" />
    </div>

    <!-- Avatar row -->
    <div class="avatar-row layer" data-depth="34">
      <div class="avatar-ring">
        <img class="avatar" src={profile.avatar} alt={`${profile.displayName}'s avatar`} />
        <span class={`status status--${profile.status}`} title={profile.status}></span>
      </div>
    </div>

    <!-- Identity -->
    <div class="identity layer" data-depth="22">
      <h1 class="name" aria-label={profile.displayName}>
        <span data-typing-text aria-hidden="true">{profile.displayName}</span>
        <span class="typing-caret" aria-hidden="true"></span>
      </h1>
      <p class="handle">@{profile.name} · {profile.pronouns}</p>
      <p class="bio">{profile.bio}</p>
    </div>

    <!-- Meta row: live views · location · occupation · like button -->
    <div class="meta layer" data-depth="16">
      <span class="meta-item" title="Page views">
        <i class="ph-fill ph-eye" aria-hidden="true"></i><span class="meta-value" data-stat="views">0</span>
      </span>
      <span class="meta-item" title="Location">
        <i class="ph-fill ph-map-pin" aria-hidden="true"></i><span class="meta-value">{profile.location}</span>
      </span>
      <span class="meta-item" title="Occupation">
        <i class="ph-fill ph-briefcase" aria-hidden="true"></i><span class="meta-value">{profile.occupation}</span>
      </span>
      <button class="meta-item meta-like" type="button" data-like aria-label="Like this page" aria-pressed="false" title="Like this page">
        <i class="ph-fill ph-heart" aria-hidden="true"></i><span class="meta-value stat-value">0</span>
      </button>
    </div>

    <!-- Live widgets: revealed by widgets.ts once their data arrives -->
    <div class="widgets layer" data-depth="14">
      <div class="widget presence" id="presenceBox" data-discord-id={profile.discordId} hidden>
        <span class="presence-avatar" id="presenceAvatar" aria-hidden="true"></span>
        <span class="presence-text">
          <span class="presence-name" id="presenceName"></span>
          <span class="presence-status" id="presenceStatus"></span>
        </span>
        <span class="presence-dot" id="presenceDot" aria-hidden="true"></span>
      </div>
      <div class="widget weather" id="weatherBox" data-weather-city={profile.weatherCity} hidden>
        <span class="weather-icon" id="weatherIcon" aria-hidden="true"></span>
        <span class="weather-text">
          <span class="weather-city" id="weatherCity"></span>
          <span class="weather-now" id="weatherNow"></span>
        </span>
      </div>
    </div>

    <!-- Socials -->
    <div class="links layer" data-depth="26">
      {profile.links.map((l) => (
        <a class="social" data-outbound href={l.href} title={l.label} aria-label={l.label} target="_blank" rel="noopener">
          <i class={l.icon} aria-hidden="true"></i>
        </a>
      ))}
    </div>

    <!-- Legal -->
    <div class="legal layer" data-depth="8">
      <button type="button" data-view="privacy">Privacy</button>
      <span aria-hidden="true">•</span>
      <button type="button" data-view="terms">Terms</button>
    </div>
  </div>
</div>

<style>
  .profile-card {
    width: min(560px, calc(100vw - 2.5rem));
    padding: 0 0 1.75rem;
  }

  /* ——— banner ——— */
  .banner {
    --z: 12px;
    position: relative;
    height: 200px;
    overflow: hidden;
    z-index: 1;
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.15);
    filter: saturate(1.3);
  }

  /* ——— avatar ——— */
  .avatar-row {
    --z: 34px;
    display: flex;
    justify-content: center;
    padding: 0 1.4rem;
    margin-top: -62px;
    position: relative;
    z-index: 3;
  }
  .avatar-ring {
    position: relative;
    width: 124px;
    height: 124px;
    border-radius: 50%;
    padding: 3px;
    background: #ff5ac8;
    box-shadow: 0 0 32px -4px rgba(255, 90, 200, 0.8), 0 8px 24px rgba(80, 15, 60, 0.5);
  }
  .avatar-ring.beaming { animation: ring-pulse 2.2s ease-in-out infinite; }
  @keyframes ring-pulse {
    0%, 100% { box-shadow: 0 0 32px -4px rgba(255, 90, 200, 0.8), 0 8px 24px rgba(80, 15, 60, 0.5); }
    50% { box-shadow: 0 0 48px -2px rgba(255, 90, 200, 1), 0 8px 24px rgba(80, 15, 60, 0.5); }
  }
  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--ring-gap);
    display: block;
  }
  .status {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 4px solid var(--status-gap);
  }
  .status--online { background: #3bff9e; box-shadow: 0 0 12px rgba(59, 255, 158, 0.9); }
  .status--idle { background: #ffce3b; box-shadow: 0 0 12px rgba(255, 206, 59, 0.9); }
  .status--dnd { background: #ff5a5a; box-shadow: 0 0 12px rgba(255, 90, 90, 0.9); }

  /* ——— identity ——— */
  .identity { --z: 22px; padding: 1rem 2.2rem 0; position: relative; z-index: 2; }
  .name {
    margin: 0;
    font-size: 2.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-shadow:
      0 0 12px rgba(255, 90, 200, 0.65),
      0 0 36px rgba(255, 90, 200, 0.45);
    animation: name-glow 3.2s ease-in-out infinite;
  }
  @keyframes name-glow {
    0%, 100% {
      text-shadow:
        0 0 12px rgba(255, 90, 200, 0.65),
        0 0 36px rgba(255, 90, 200, 0.45);
    }
    50% {
      text-shadow:
        0 0 18px rgba(255, 130, 220, 0.9),
        0 0 54px rgba(255, 90, 200, 0.65);
    }
  }
  .typing-caret {
    width: 0.12em;
    height: 1.15em;
    margin-left: 0.12rem;
    background: var(--accent-soft);
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(255, 90, 200, 0.8);
    animation: caret-blink 1.05s step-end infinite;
  }
  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .handle { margin: 0.15rem 0 0; font-size: 0.95rem; font-weight: 500; color: var(--handle); text-align: center; overflow-wrap: anywhere; }
  .bio { margin: 0.8rem 0 0; font-size: 1.02rem; font-weight: 300; line-height: 1.55; color: var(--text-body); text-align: center; overflow-wrap: anywhere; }

  /* ——— meta row ——— */
  .meta {
    --z: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    padding: 1rem 2rem 0;
    position: relative;
    z-index: 2;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    background: none;
    border: none;
    box-shadow: none;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .meta-item i { font-size: 1rem; color: var(--accent-soft); }
  .meta-value { white-space: nowrap; }
  .meta-like { cursor: pointer; transition: color 0.2s ease; }
  .meta-like:hover, .meta-like.liked { color: #ff5a8a; }
  .meta-like:hover i, .meta-like.liked i { color: #ff5a8a; }
  .meta-item.beaming { animation: text-pulse 2.2s ease-in-out infinite; }

  /* ——— live widgets (presence / weather) ——— */
  .widgets {
    --z: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 1.6rem 0;
    position: relative;
    z-index: 2;
  }
  .widgets:has(.widget:not([hidden])) { padding-bottom: 0.1rem; }
  .widget {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0.9rem;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-inset);
  }
  body.light .widget { background: rgba(255, 255, 255, 0.5); }
  .widget[hidden] { display: none; }
  .presence-avatar {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: rgba(255, 90, 200, 0.25);
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
  }
  .presence-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .presence-text, .weather-text { min-width: 0; display: flex; flex-direction: column; line-height: 1.35; }
  .presence-name { font-size: 0.9rem; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .presence-status { font-size: 0.76rem; font-weight: 400; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .presence-dot {
    margin-left: auto;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #808080;
  }
  .presence-dot--online { background: #3bff9e; box-shadow: 0 0 10px rgba(59, 255, 158, 0.9); }
  .presence-dot--idle { background: #ffce3b; box-shadow: 0 0 10px rgba(255, 206, 59, 0.9); }
  .presence-dot--dnd { background: #ff5a5a; box-shadow: 0 0 10px rgba(255, 90, 90, 0.9); }
  .weather-icon { flex-shrink: 0; font-size: 1.9rem; color: var(--accent-soft); display: grid; place-items: center; width: 46px; }
  .weather-city { font-size: 0.9rem; font-weight: 700; color: var(--text); }
  .weather-now { font-size: 0.76rem; font-weight: 400; color: var(--text-muted); }

  /* ——— socials ——— */
  .links {
    --z: 26px;
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.3rem 1.5rem 0;
    position: relative;
    z-index: 2;
  }
  .social {
    position: relative;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    color: var(--accent-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .social:hover { color: var(--social-hover-color); }
  .social.beaming { animation: icon-pulse 2.2s ease-in-out infinite; }
  .social i { position: relative; z-index: 1; transition: transform 0.3s ease; }
  .social:hover i { transform: scale(1.12) rotate(-6deg); }

  /* ——— legal ——— */
  .legal {
    --z: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    padding: 1.3rem 1.5rem 0;
    position: relative;
    z-index: 2;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-faint);
  }
  .legal button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .legal button:hover { color: var(--accent-soft); }
  .legal button.beaming { animation: text-pulse 2.2s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .social, .social i { transition: none; }
    .name { animation: none; }
    .typing-caret { display: none; }
  }
</style>
